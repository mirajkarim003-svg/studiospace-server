# ---- StudioSpace server (copy this file to .env and fill in) ----
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017 for local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=studiospace

# Must be EXACTLY the same value as JWT_SECRET in the client .env.local
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# URL of the Next.js client (comma separate for several, e.g. local + live)
CLIENT_URL=http://localhost:3000
